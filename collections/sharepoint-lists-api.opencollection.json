            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new list on the current site."
        },
        {
          "info": {
            "name": "SharePoint Get List by Title",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site_url}/_api/web/lists/getbytitle(':list_title')",
            "params": [
              {
                "name": "list_title",
                "value": "Documents",
