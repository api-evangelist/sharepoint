          "http": {
            "method": "GET",
            "url": "https://{site_url}/_api/web/lists",
            "params": [
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Properties to return."
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression."
              },
              {
                "name": "$top",
                "value": "10",
                "type": "query",
                "description": "Maximum results to return."
              }
            ]
          },
          "docs": "Retrieve all lists on the current site."
        },
        {
          "info": {
